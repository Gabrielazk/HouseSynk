<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>ab6cc2d0-3b78-498f-9eaf-ad9fe288c5a3</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>main.py</StartupFile>
    <SearchPath>.</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>HouseSynk</Name>
    <RootNamespace>HouseSynk</RootNamespace>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <EnableNativeCodeDebugging>False</EnableNativeCodeDebugging>
    <InterpreterId>MSBuild|env311|$(MSBuildProjectFullPath)</InterpreterId>
    <SuppressPackageInstallationPrompt>True</SuppressPackageInstallationPrompt>
    <TestFramework>Pytest</TestFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="main.py" />
    <Compile Include="src\calculators\baldrame.py" />
    <Compile Include="src\calculators\brocas.py" />
    <Compile Include="src\calculators\contrapiso.py" />
    <Compile Include="src\calculators\eletrica.py" />
    <Compile Include="src\calculators\embalagens.py" />
    <Compile Include="src\calculators\esquadrias.py" />
    <Compile Include="src\calculators\hidraulica.py" />
    <Compile Include="src\calculators\laje.py" />
    <Compile Include="src\calculators\paredes.py" />
    <Compile Include="src\calculators\pintura.py" />
    <Compile Include="src\calculators\reboco.py" />
    <Compile Include="src\calculators\rejunte.py" />
    <Compile Include="src\calculators\reserva.py" />
    <Compile Include="src\calculators\revestimento.py" />
    <Compile Include="src\calculators\telhado.py" />
    <Compile Include="src\calculators\tracos.py" />
    <Compile Include="src\calculators\unidades.py" />
    <Compile Include="src\calculators\__init__.py" />
    <Compile Include="src\models\database.py" />
    <Compile Include="src\models\material.py" />
    <Compile Include="src\models\__init__.py" />
    <Compile Include="src\services\lista_compras.py" />
    <Compile Include="src\services\pdf_generator.py" />
    <Compile Include="src\services\__init__.py" />
    <Compile Include="src\views\calculator_screen.py" />
    <Compile Include="src\views\comum.py" />
    <Compile Include="src\views\history_screen.py" />
    <Compile Include="src\views\home_screen.py" />
    <Compile Include="src\views\login_screen.py" />
    <Compile Include="src\views\main_screen.py" />
    <Compile Include="src\views\rolagem.py" />
    <Compile Include="src\views\settings_screen.py" />
    <Compile Include="src\views\summary_screen.py" />
    <Compile Include="src\views\textos_eua.py" />
    <Compile Include="src\views\__init__.py" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="assets\" />
    <Folder Include="src\" />
    <Folder Include="src\calculators\" />
    <Folder Include="src\models\" />
    <Folder Include="src\views\" />
    <Folder Include="src\services\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\README.md">
      <Link>README.md</Link>
    </Content>
    <Content Include="requirements.txt" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="env311\">
      <Id>env311</Id>
      <Version>3.11</Version>
      <Description>env311 (Python 3.11 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
